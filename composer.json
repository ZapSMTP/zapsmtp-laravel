{
    "name": "zapsmtp/zapsmtp-laravel",
    "description": "The official Laravel integration for the ZapSMTP email API: mail driver, webhooks, suppression sync, artisan commands, test fake",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mail",
        "email",
        "transactional email",
        "zapsmtp",
        "webhooks"
    ],
    "homepage": "https://zapsmtp.com/docs/sdks/",
    "require": {
        "php": "^8.2",
        "guzzlehttp/psr7": "^2.4",
        "illuminate/bus": "^12.60 || ^13.0",
        "illuminate/cache": "^12.60 || ^13.0",
        "illuminate/console": "^12.60 || ^13.0",
        "illuminate/contracts": "^12.60 || ^13.0",
        "illuminate/database": "^12.60 || ^13.0",
        "illuminate/http": "^12.60 || ^13.0",
        "illuminate/mail": "^12.60 || ^13.0",
        "illuminate/notifications": "^12.60 || ^13.0",
        "illuminate/queue": "^12.60 || ^13.0",
        "illuminate/routing": "^12.60 || ^13.0",
        "illuminate/support": "^12.60 || ^13.0",
        "psr/http-client": "^1.0",
        "symfony/mailer": "^7.2 || ^8.0",
        "symfony/mime": "^7.2 || ^8.0",
        "zapsmtp/zapsmtp-php": "^0.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.11 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5.3 || ^12.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "symlink": false,
                "versions": {
                    "zapsmtp/zapsmtp-php": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "ZapSMTP\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZapSMTP\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZapSMTP\\Laravel\\ZapSMTPServiceProvider"
            ],
            "aliases": {
                "ZapSMTP": "ZapSMTP\\Laravel\\Facades\\ZapSMTP"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "suggest": {
        "phpunit/phpunit": "For ZapSMTP::fake() assertions in your tests"
    }
}
